# ======================
# DATABASE (PostgreSQL 15)
# ======================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aurum_dev

# ======================
# REDIS (cache / sessions / cart)
# ======================
REDIS_URL=redis://localhost:6379

# ======================
# STRIPE  (https://dashboard.stripe.com/apikeys)
# ======================
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_key_here

# ======================
# SENDGRID  (https://app.sendgrid.com/settings/api_keys)
# ======================
SENDGRID_API_KEY=SG.your_key_here
SENDGRID_FROM_EMAIL=orders@aurum.luxury
SENDGRID_FROM_NAME=AURUM

# ======================
# JWT & AUTH
# ======================
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_a_random_32_char_string_here_please_change
JWT_EXPIRY=7

# ======================
# AWS S3 (product images) — optional locally
# ======================
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=aurum-images
AWS_S3_URL=https://aurum-images.s3.amazonaws.com
AWS_CLOUDFRONT_URL=

# ======================
# APP CONFIG
# ======================
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
PORT=8080
LOG_LEVEL=debug

# ======================
# CORS & SECURITY
# ======================
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100

# ======================
# TAX / COMMERCE
# ======================
# Flat sales-tax rate applied at checkout (e.g. 0.08 = 8%).
TAX_RATE=0.08

# ======================
# SENTRY (optional)
# ======================
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
